{
  "name": "react-qr-scan",
  "version": "1.0.0",
  "description": "A React Component for read QR codes from the camera",
  "scripts": {
    "build": "rollup -c",
    "prepublish": "yarn build",
    "lint": "eslint --fix 'src/**'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy-storybook": "storybook-to-ghpages"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssttechdev/react-qr-scan.git"
  },
  "keywords": [
    "react",
    "qr",
    "qrcode",
    "qrreader"
  ],
  "author": "thomas billiet",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ssttechdev/react-qr-scan/issues"
  },
  "homepage": "https://github.com/ssttechdev/react-qr-scan#readme",
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "dependencies": {
    "@zxing/browser": "0.0.7",
    "@zxing/library": "^0.18.6",
    "rollup": "^2.79.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-syntax-flow": "^7.14.5",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-typescript": "^8.5.0",
    "@storybook/addon-essentials": "^7.6.21",
    "@storybook/react-webpack5": "^7.6.21",
    "@storybook/storybook-deployer": "^2.8.16",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^8.4.1",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^4.3.8",
    "lint-staged": "^10.5.4",
    "prettier": "^2.8.8",
    "react": "^18.3.1",
    "react-docgen-typescript-loader": "^3.7.2",
    "react-dom": "^18.3.1",
    "rollup-plugin-dts": "^4.2.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-web-worker-loader": "^1.7.0",
    "source-map-explorer": "^2.5.3",
    "storybook": "^7.6.21",
    "ts-loader": "^8.4.0",
    "typescript": "^4.9.5"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md,scss}": [
      "prettier --write",
      "git add"
    ]
  }
}
